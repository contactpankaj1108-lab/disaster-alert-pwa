# ==============================================================================
# ResQAlert - Disaster Alert & Emergency Resource PWA Environment Configuration
# Copy this file to .env and configure your production secrets.
# NEVER commit your production .env with real credentials to version control.
# ==============================================================================

# Server Network Configuration
PORT=3001
NODE_ENV=development

# Cryptographic Session & Token Signing Secret (Minimum 32 random characters in production)
SESSION_SECRET=your_long_random_session_secret_key_minimum_32_chars_here

# Demonstration & Evaluation Settings
# Set to 'false' in production environments to disable built-in evaluation accounts
DEMO_ACCOUNTS_ENABLED=true

# API Base URL (optional override for decoupled deployments)
VITE_API_URL=
